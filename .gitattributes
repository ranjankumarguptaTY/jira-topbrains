# Set default behavior to automatically normalize line endings
* text=auto

# Explicit text files
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.txt text eol=lf
*.cfg text eol=lf
*.env* text eol=lf
*.bat text eol=crlf
*.sh text eol=lf
