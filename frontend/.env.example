# ==============================================================================
# TopBrains Collaboration Platform - Frontend Environment Configuration
# ==============================================================================

# Backend API Base URL
# For local development with Vite proxy: leave empty or use http://localhost:8000
# For production server: https://api.yourdomain.com or /api
VITE_API_URL="http://localhost:8000"

# WebSocket Endpoint URL
# For local development: ws://localhost:8000/ws
# For production server: wss://api.yourdomain.com/ws or wss://yourdomain.com/ws
VITE_WS_URL="ws://localhost:8000/ws"
