# ==============================================================================
# TopBrains Collaboration Platform - Backend Environment Configuration
# ==============================================================================

# Application
PROJECT_NAME="TopBrains Collaboration Platform"
SECRET_KEY="replace-this-with-a-secure-random-32-character-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# MongoDB Configuration
# Local MongoDB: mongodb://localhost:27017
# Docker MongoDB: mongodb://mongo:27017
# MongoDB Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL="mongodb://localhost:27017"
DATABASE_NAME="topbrains_jira_db"

# Master Super Admin Account (Auto-created on server startup)
SUPER_ADMIN_EMAIL="admin@topbrains.com"
SUPER_ADMIN_PASSWORD="YourSecureAdminPassword123!"
SUPER_ADMIN_NAME="TopBrains Master Admin"

# Initial Seeding
# Set AUTO_SEED=true only if you want demo organizations, sample teams, and mock tickets auto-generated on first boot
AUTO_SEED=false

# Security & CORS
# Comma-separated list of allowed frontend domains
ALLOWED_ORIGINS="http://localhost:5173,https://yourdomain.com,https://app.yourdomain.com"
RATE_LIMIT_AUTH=20

# File Storage
MAX_FILE_SIZE_MB=250
TEMP_FILE_EXPIRY_DAYS=15
TEMP_STORAGE_LIMIT_GB=1500
FILE_TRANSFER_DIR="./data/file-transfers"
