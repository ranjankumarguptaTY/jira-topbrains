# ================================================================
# TopBrains Agile Collaboration Platform — Environment Config (.env)
# ================================================================

# --- MongoDB Database Configuration ---
# For Local MongoDB:
# MONGODB_URL=mongodb://localhost:27017
#
# For MongoDB Atlas (Cloud) / Production Cluster:
# MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=mongodb://localhost:27017

# Database Name
DATABASE_NAME=topbrains_jira_db

# --- Security & JWT Authentication ---
# Secret key used for signing JWT access tokens (use a strong random string in production)
SECRET_KEY=super-secret-jira-clone-jwt-key-change-in-production-123456789
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Allowed CORS Origins (comma-separated, or * for all)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://localhost:80

# --- Super Admin Account (Auto-Created on Startup if not exists) ---
SUPER_ADMIN_EMAIL=admin@topbrains.com
SUPER_ADMIN_PASSWORD=adminpassword123
SUPER_ADMIN_NAME=TopBrains Super Admin

# Set to true if you want to automatically seed demo data on fresh deployment
AUTO_SEED=false

# --- Storage Limits ---
MAX_FILE_SIZE_MB=250
TEMP_FILE_EXPIRY_DAYS=15
TEMP_STORAGE_LIMIT_GB=1500
FILE_TRANSFER_DIR=./data/file-transfers
